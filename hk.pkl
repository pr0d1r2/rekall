/// rekall's gate, defined ONCE (V23).
///
/// Every op below is a plain command a human can paste into a shell (V24).
/// hk decides *when* they run -- which files changed, which hook, in what
/// order -- and never what it means to pass, so a verdict never rests on the
/// runner's own logic and stays reproducible without it.
///
/// The schema is VENDORED at `pkl/Config.pkl` rather than fetched from a
/// `package://` URL at eval time (V25): the gate must run with no network,
/// because a gate that needs one is a gate that goes soft on a plane, in a
/// locked-down CI, and on the day that host is down.
amends "pkl/Config.pkl"

/// Success is SILENCE (V28). Output that always appears is output nobody
/// reads, which is how a real failure hides in noise everyone learned to
/// scroll past.
///
/// `fail_fast` locally because the loop is cheap, so the FIRST failure is the
/// most useful thing to surface, and `depends` orders steps cheapest-first so
/// it arrives fast.
fail_fast = true

/// V26: a SKIP MUST BE SAID. Kept even though the optional tools below no
/// longer rely on it, because it is the setting that makes any FUTURE
/// condition-skipped step visible instead of silent, and the default hides
/// exactly that case. A skip nobody sees reads like a pass, and green is
/// the most expensive lie a gate can tell.
display_skip_reasons = List("profile-not-enabled", "condition-false")

env {
  ["HK_HIDE_WHEN_DONE"] = "true"
}

/// The COMMIT tier: everything cheap enough that nobody is tempted to bypass
/// it. `depends` chains the cargo steps deliberately -- cargo takes a lock on
/// the target directory, so two cargo jobs launched in parallel do not run in
/// parallel; the second blocks on "Blocking waiting for file lock on build
/// directory", which READS AS A HANG.
local fast = new Mapping<String, Step> {
  /// THE PRESENCE GATE (V26). A missing runner is NOT a pass.
  ///
  /// Every tool whose VERDICT this crate owns, checked in one place before
  /// anything else runs: `cargo` for the build and the tests, `mth` for
  /// SPEC.md's format, `itok` for the ceiling, `rekall` for its own corpus.
  /// If one is absent the gate goes RED, because a step that silently did
  /// not happen reports the same green as a step that passed.
  ///
  /// ONE definition rather than a guard pasted into ten steps (V23). It
  /// carries no `glob`, so it always runs, and everything else chains from
  /// it -- a presence check that only fires when a Rust file changed would
  /// miss the case where nothing changed and nothing was checked.
  ///
  /// The optional third-party tools are deliberately NOT here. V26 draws
  /// the line at ownership: this crate answers for what `cargo test` says,
  /// and does not answer for whether `typos` is installed. Those skip and
  /// SAY SO, which is the other half of the same rule.
  ["runners"] {
    check = """
      missing=''
      for tool in cargo mth itok rekall; do
        command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
      done
      [ -z "$missing" ] || { echo "hk: MISSING owned runner(s):$missing -- a missing runner is NOT a pass (V26), so this gate is RED rather than quietly shorter. Enter the dev shell: 'direnv allow', or 'nix develop' from the repo root." >&2; exit 1; }
      """
  }

  ["fmt"] {
    glob = List("**/*.rs")
    depends = List("runners")
    check = "cargo fmt --check"
    fix = "cargo fmt"
  }

  /// `-D warnings` is passed AFTER `--` rather than through RUSTFLAGS.
  /// RUSTFLAGS reaches PATH DEPENDENCIES, and V8 commits this crate to
  /// taking `itok` as one -- so the RUSTFLAGS form would let a sibling's
  /// stray warning redden this gate for code this crate does not own.
  ///
  /// No allow-list and no lint-debt file. This crate started at zero lines,
  /// so it can hold the full deny list from commit one; adopting it later
  /// would mean measuring a debt and ratcheting it down instead (V12, V27).
  ["clippy"] {
    glob = List("**/*.rs")
    depends = List("fmt")
    check = """
      cargo clippy --all-targets -- -D warnings || { echo 'hk: clippy is RED. Fix the code, not the threshold -- raising a number in clippy.toml to clear a limit is the exact reflex those limits exist to catch. An allow added instead must NAME what it exempts and why.' >&2; exit 1; }
      """
  }

  /// ASCII-only Rust source (SPEC.md §C): Trojan-Source resistance, and
  /// plain legibility for the models this tool exists to serve. SPEC.md is
  /// deliberately NOT in the glob -- its symbols are FORMAT, not source.
  ///
  /// The pattern is a POSIX RANGE under LC_ALL=C, not `grep -P` and not a
  /// `[:print:]` class. MEASURED on this box: `-P` does not exist in BSD
  /// grep, and `[^[:print:][:blank:]]` matched nothing against a UTF-8 byte
  /// pair there -- so both forms would have passed silently on half the
  /// supported platforms, which is a gate that reports green for a check it
  /// never performed (V26).
  ["ascii"] {
    glob = List("**/*.rs")
    check = """
      hits=$(LC_ALL=C grep -rn '[^ -~]' src/ || true)
      [ -z "$hits" ] || { echo 'hk: non-ASCII or control character in Rust source:' >&2; echo "$hits" >&2; echo 'SPEC.md symbols are FORMAT, not source -- spell it in ASCII here.' >&2; exit 1; }
      """
  }

  /// MODULE SIZE, the limit clippy does not have.
  ///
  /// It caps methods, parameters, nesting and complexity -- and nothing
  /// caps a FILE. `src/cli.rs` reached 1,878 lines of code with every
  /// function inside it passing, because the one dimension nobody
  /// measured is the one that drifted. V22, in the gate that was missing.
  ///
  /// CODE lines only: everything before `#[cfg(test)]`. A thorough test
  /// module is not the smell -- a file doing ten jobs is.
  ["module-size"] {
    glob = List("**/*.rs")
    check = """
      over=$(for f in $(find src -name '*.rs'); do
        n=$(awk 'index($0, "#[cfg(test)]") == 1 {print NR-1; found=1; exit} END{if (!found) print NR}' "$f")
        if [ "$n" -gt 500 ]; then echo "  $n  $f"; fi
      done)
      [ -z "$over" ] || { echo 'hk: module over 500 CODE lines (lines before `#[cfg(test)]`):' >&2; echo "$over" >&2; echo 'Split it by responsibility -- clippy caps functions but nothing caps a file, which is how cli.rs reached 1,878. Do NOT raise this to make it pass.' >&2; exit 1; }
      """
  }

  ["test"] {
    /// A step's glob must name every INPUT its tests read, not just the
    /// language they are written in. Cargo.toml is here because the version
    /// and lint set live there; SPEC.md will join it the moment a test reads
    /// it, which T19 makes inevitable.
    glob = List("**/*.rs", "Cargo.toml")
    depends = List("clippy")
    check = """
      cargo test || { echo 'hk: a test failed. Decide WHICH kind before editing: a code bug, or a spec gap. A gap goes through SPEC.md first -- append the cause to section B so the invariant that would have caught it exists before the fix does.' >&2; exit 1; }
      """
  }

  /// THE FORMAT OWNER. `mth` owns SPEC.md's format (§C) and arrives as a
  /// pinned flake input rather than off PATH, because the last time it was
  /// merely expected on PATH the check was silently deferred and nothing
  /// reported it (V26).
  ["spec-fmt"] {
    glob = List("SPEC.md")
    check = "mth fmt --check SPEC.md"
    fix = "mth fmt SPEC.md"
  }

  ["spec-check"] {
    glob = List("SPEC.md")
    depends = List("spec-fmt")
    check = """
      mth check SPEC.md || { echo 'hk: SPEC.md failed its own format check. Fix the spec, not the checker -- mth owns this format (section C) and this repo is its consumer.' >&2; exit 1; }
      """
  }

  /// THE CEILING'S RUNNER (V22). `itok check` reads `.context-limits` and
  /// exits nonzero on a breach, using its pinned tokenizer tier so the count
  /// is reproducible rather than a per-run estimate.
  ///
  /// Delegated, never reimplemented: itok owns token accounting (V8), and a
  /// second counter here would disagree with it eventually -- which is the
  /// same defect as two rule sets, and the one that argues loudest for
  /// itself because both numbers look plausible.
  ///
  /// On the COMMIT tier deliberately. The whole point of V12 is that the
  /// ceiling is felt while the file is being edited; a breach discovered on
  /// push is a breach discovered after the reasoning that caused it has been
  /// written and defended.
  ["context-limits"] {
    glob = List("SPEC.md", "README.md", ".context-limits")
    check = """
      itok check || { echo 'hk: a path is over its ceiling in .context-limits. Cut the file, or RAISE the number in a commit that says why -- a threshold raised reflexively trains the reflex instead of catching the problem (V12, V22).' >&2; exit 1; }
      """
  }

  /// CONSUMER #0 (T19). This crate checks its OWN corpus with its own
  /// binary -- a tool that gates other people's extractions and not its own
  /// is a tool nobody has run in anger.
  ///
  /// `rekall` reaches PATH through the dev shell's cargo-run shim, so this
  /// is the crate's own build and not a stale global install. It is an
  /// OWNED step: if the binary is missing the step FAILS rather than
  /// skipping, because a silent skip is a pass nobody earned (V26).
  ///
  /// On the COMMIT tier because it is cheap -- it reads a ledger and the
  /// handful of files that ledger names, with no network and no key (V6).
  ///
  /// The glob is the LEDGER and the places extraction touches. Today this
  /// repo has extracted nothing, so the step has nothing to say; it starts
  /// biting the moment the first statement moves, which is the commit where
  /// the obligation actually appears.
  ["rekall-check"] {
    glob = List(".rekall/**", "CLAUDE.md", "AGENTS.md", ".claude/skills/**")
    check = """
      rekall check || { echo 'hk: rekall found drift in its own corpus. Every line above already names its fix -- this note only says the failure is real and not a tooling error.' >&2; exit 1; }
      """
  }

  /// `nixfmt --check` gates the flake itself: that file decides what every
  /// other step runs with, so drift there is drift everywhere.
  /// The four steps below are OPTIONAL THIRD-PARTY tools, and V26 gives
  /// them the other treatment: absent means SKIP, and the skip is NAMED.
  ///
  /// The guard is a PRELUDE INSIDE the check, and it was hk's own
  /// `step_condition` first. MEASURED: with `display_skip_reasons`
  /// carrying "condition-false", a step whose condition evaluated false
  /// was reported at DEBUG level and NOWHERE ELSE --
  ///
  ///     DEBUG typos: condition: exec('command -v typos') = false
  ///
  /// -- so the run exited 0 having said nothing about a check it never
  /// performed. hk's native facility produces precisely the silent skip
  /// V26 forbids, which is the whole reason to prefer it and the reason
  /// it cannot be used.
  ///
  /// V24 still holds. Its rule is that hk decides WHEN and never what
  /// passing MEANS; the verdict here is still `typos`'s, the prelude only
  /// announces its absence, and the whole thing is still a plain command
  /// a human can paste.
  ["nixfmt"] {
    glob = List("**/*.nix")
    check = """
      command -v nixfmt >/dev/null 2>&1 || { echo "hk: SKIPPED nixfmt -- not on PATH. Optional third-party tool, so this is a skip, not a failure (V26). Enter the dev shell to run it." >&2; exit 0; }
      nixfmt --check flake.nix
      """
    fix = "nixfmt flake.nix"
  }

  ["taplo"] {
    glob = List("**/*.toml")
    check = """
      command -v taplo >/dev/null 2>&1 || { echo "hk: SKIPPED taplo -- not on PATH. Optional third-party tool, so this is a skip, not a failure (V26). Enter the dev shell to run it." >&2; exit 0; }
      taplo fmt --check
      """
    fix = "taplo fmt"
  }

  ["typos"] {
    glob = List("**/*")
    check = """
      command -v typos >/dev/null 2>&1 || { echo "hk: SKIPPED typos -- not on PATH. Optional third-party tool, so this is a skip, not a failure (V26). Enter the dev shell to run it." >&2; exit 0; }
      typos
      """
    fix = "typos --write-changes"
  }

  /// Secrets. hk's `detect-private-key` builtin does exactly what its name
  /// says and nothing else, so a token-shaped secret walks straight past it.
  ["ripsecrets"] {
    glob = List("**/*")
    check = """
      command -v ripsecrets >/dev/null 2>&1 || { echo "hk: SKIPPED ripsecrets -- not on PATH. Optional third-party tool, so this is a skip, not a failure (V26). Enter the dev shell to run it." >&2; exit 0; }
      ripsecrets || { echo 'hk: a secret is in a tracked file. ROTATE it -- deleting the line does not help, because git history keeps every version of it.' >&2; exit 1; }
      """
  }
}

/// The PUSH tier: everything too slow for a commit hook. A ~60s step on
/// commit is a step someone learns to bypass, and a bypassed hook is worse
/// than no hook.
local all = (fast) {
  /// Doc examples are TESTS. The one on `config::merge` pins the union
  /// rule -- the single asymmetry in the merge -- so the behaviour that is
  /// easiest to "simplify" away is asserted by the documentation that
  /// explains it.
  ///
  /// Absent from commit one because the crate was bin-only and `cargo test
  /// --doc` errors with "no library targets found". A step that cannot pass
  /// is not a gate, it is a red nobody can clear (T32).
  ["doctest"] {
    glob = List("**/*.rs")
    depends = List("test")
    check = """
      cargo test --doc || { echo 'hk: a doc example failed. Doc examples are TESTS: fix the example or the code, and do not reach for no_run to quiet it.' >&2; exit 1; }
      """
  }

  ["rustdoc"] {
    glob = List("**/*.rs")
    depends = List("doctest")
    check = """
      cargo doc --no-deps --quiet || { echo 'hk: rustdoc failed, usually a broken intra-doc link. Fix the link target or spell it out in backticks.' >&2; exit 1; }
      """
  }

  /// The crate must build with no default features, because a consumer may
  /// take it that way and nothing else here would notice.
  ["no-default-features"] {
    glob = List("**/*.rs", "Cargo.toml")
    depends = List("rustdoc")
    check = """
      cargo build --no-default-features --quiet || { echo 'hk: the crate does not build without default features, and a consumer may take it that way. Gate the feature-dependent code with cfg, or make the dependency non-optional and say why.' >&2; exit 1; }
      """
  }

  /// Publishing does not ship the REPO, it ships a tarball whose file set is
  /// DERIVED -- git-tracked, minus `exclude`. That is a second file set
  /// nothing else in this repo examines.
  ["package"] {
    glob = List("**/*.rs", "Cargo.toml")
    depends = List("no-default-features")
    check = """
      cargo package --quiet --allow-dirty || { echo 'hk: cargo package failed. It ships a DERIVED file set -- git-tracked minus exclude -- so this is usually a path the tarball needs and does not have, or an exclude in Cargo.toml that took too much.' >&2; exit 1; }
      """
  }

  /// THE RATCHET (V27). The floor may RISE, never fall, and it MUST rise
  /// when coverage does. `.coverage` carries the number.
  ///
  /// Two margins, and they are not symmetric on purpose. A fall of up to
  /// 0.3 is tolerated as measurement jitter. A rise of more than 0.5 is a
  /// FAILURE, cleared by `hk fix --all`, which records it.
  ///
  /// That second half was missing and the gate was quietly broken by it.
  /// hk runs a step's `fix` only when its `check` FAILS, so a rise -- which
  /// passed -- never reached the code that records it, and the printed
  /// advice named a command (`hk run fix`) that does not exist. The floor
  /// would have drifted further below reality with every well-tested
  /// commit, protecting less and less while reporting green.
  ///
  /// Failing on a stale floor is the same shape as `cargo fmt --check`
  /// failing on an unformatted file: not a complaint about the work, just
  /// a record that has not caught up. One command fixes it.
  ///
  /// It starts at the scaffold's own figure rather than at an aspirational
  /// one: a floor nobody can pay gates every commit red for weeks, and the
  /// first thing anyone does with a gate they cannot pay is bypass it.
  ["coverage"] {
    glob = List("**/*.rs", ".coverage")
    depends = List("package")
    check = """
      out=$(cargo llvm-cov --summary-only 2>&1) || { echo "$out" >&2; exit 1; }
      now=$(printf '%s' "$out" | awk '/^TOTAL/{gsub("%","",$10); print $10}')
      was=$(awk '/^lines /{print $2}' .coverage)
      [ -n "$now" ] || { echo 'hk: could not read a coverage total -- that is an ERROR, not a floor breach' >&2; exit 1; }
      awk -v n="$now" -v w="$was" 'BEGIN{exit !(n+0 < w+0 - 0.3)}' && { echo "hk: coverage FELL, $was% -> $now% (margin 0.3). A line that stopped being covered is a test that stopped asserting. Cover it, or say why in .coverage with the drop." >&2; exit 1; }
      awk -v n="$now" -v w="$was" 'BEGIN{exit !(n+0 > w+0 + 0.5)}' && { echo "hk: coverage ROSE, $was% -> $now%, and the floor was not raised. An unrecorded rise is a floor that lies about what is protected -- it would let every one of those lines go uncovered again in silence. Run: hk fix --all" >&2; exit 1; }
      echo "coverage $now% (floor $was%)"
      """
    /// `fix` may only RAISE. A ratchet that writes down whatever it measures
    /// is not a ratchet -- it files down its own teeth on exactly the commit
    /// it existed to refuse (V27).
    fix = """
      out=$(cargo llvm-cov --summary-only 2>&1) || { echo "$out" >&2; exit 1; }
      now=$(printf '%s' "$out" | awk '/^TOTAL/{gsub("%","",$10); print $10}')
      was=$(awk '/^lines /{print $2}' .coverage)
      [ -n "$now" ] || exit 1
      awk -v n="$now" -v w="$was" 'BEGIN{exit !(n+0 < w+0)}' && { echo "hk: refusing to RECORD a drop, $was% -> $now%. Cover the gap, or edit .coverage by hand with the reason." >&2; exit 1; }
      awk -v n="$now" '/^lines /{print "lines " n; next} {print}' .coverage > .coverage.new
      mv .coverage.new .coverage
      """
  }
}

hooks {
  /// `stash = "git"` is correctness, not speed -- without it a partially
  /// staged file (`git add -p`) is checked as it looks in the WORKTREE,
  /// giving a verdict about code you are not committing.
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = fast
  }

  ["pre-push"] {
    steps = all
  }

  /// What `hk check` runs -- the entry point for CI and for a by-hand full
  /// run. ONE definition, many callers (V23): CI calls this, it does not
  /// copy the step list into a workflow file.
  ["check"] {
    steps = all
  }

  ["fix"] {
    fix = true
    steps = all
  }
}
