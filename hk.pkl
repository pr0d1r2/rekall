/// rekall's gate, defined ONCE (V23).
///
/// Every op below is a plain command a human can paste into a shell (V24).
/// hk decides *when* they run -- which files changed, which hook, in what
/// order -- and never what it means to pass, so a verdict never rests on the
/// runner's own logic and stays reproducible without it.
///
/// The schema is VENDORED at `pkl/Config.pkl` rather than fetched from a
/// `package://` URL at eval time (V25): the gate must run with no network,
/// because a gate that needs one is a gate that goes soft on a plane, in a
/// locked-down CI, and on the day that host is down.
amends "pkl/Config.pkl"

/// Success is SILENCE (V28). Output that always appears is output nobody
/// reads, which is how a real failure hides in noise everyone learned to
/// scroll past.
///
/// `fail_fast` locally because the loop is cheap, so the FIRST failure is the
/// most useful thing to surface, and `depends` orders steps cheapest-first so
/// it arrives fast.
fail_fast = true

/// V26: a SKIP MUST BE SAID. Kept even though the optional tools below no
/// longer rely on it, because it is the setting that makes any FUTURE
/// condition-skipped step visible instead of silent, and the default hides
/// exactly that case. A skip nobody sees reads like a pass, and green is
/// the most expensive lie a gate can tell.
display_skip_reasons = List("profile-not-enabled", "condition-false")

env {
  ["HK_HIDE_WHEN_DONE"] = "true"
}

/// The COMMIT tier: everything cheap enough that nobody is tempted to bypass
/// it. `depends` chains the cargo steps deliberately -- cargo takes a lock on
/// the target directory, so two cargo jobs launched in parallel do not run in
/// parallel; the second blocks on "Blocking waiting for file lock on build
/// directory", which READS AS A HANG.
/// The BADGE BLOCK's renderer, defined ONCE and shared by both halves of the
/// `badges` step below (V23). A generator whose check and fix render
/// separately is two renderers, and the one that rots is whichever runs less.
///
/// EVERY NUMBER IS DERIVED, and that is the point rather than a convenience.
/// A badge's alt text and its shields.io URL are filled from the SAME shell
/// variable, so the drift that put `![invariants 59]` in front of an
/// `invariants-63` URL is not merely detected -- it cannot be written.
///
/// STEP COUNTS COME FROM HK'S OWN PLAN, never from a line-range parse of this
/// file. hk.pkl is the gate DEFINITION and a second reading of it is the
/// second rule set V23 forbids. `--plan` evaluates without executing, and it
/// lists every DEFINED step whatever its file-match status, so the count does
/// not move with whatever happens to be staged.
///
/// `< /dev/null` IS LOAD-BEARING on the pre-push call. A real pre-push hook
/// reads its refs from stdin, `hk run pre-push` honours that contract, and
/// without the redirect it BLOCKS on an inherited terminal. The first draft
/// hung for two minutes producing no output at all, which is the failure mode
/// V28 cares about: silence that looks like work.
///
/// NO BACKSLASHES, for the reason `shipped-links` records: pkl does not
/// collapse them in a triple-quoted string, so one written here reaches the
/// shell doubled. Bracket classes do the same work and survive the trip.
///
/// The PLATFORM and `built with` badges stay LITERAL, deliberately. flake.nix
/// declares four systems and the block shows four platform badges, but the
/// correspondence is editorial: `intel linux` and `amd linux` are one system,
/// and `x86_64-darwin` is supported with no badge at all -- the same gap
/// ci.yml names out loud. Deriving them would invent a mapping that is not
/// there, which is worse than writing the four lines down.
///
/// A source that reads EMPTY or ZERO aborts the render. A generator that
/// silently emits `direct dependencies 0` writes a confident wrong number
/// into the file it exists to keep true.
local renderBadges = """
render_badges() {
  specs() { find . -name SPEC.md -not -path './target/*' -not -path './.git/*'; }
  lic=$(grep -m1 '^license = ' Cargo.toml | cut -d'"' -f2)
  ed=$(grep -m1 '^edition = ' Cargo.toml | cut -d'"' -f2)
  msrv=$(grep -m1 '^rust-version = ' Cargo.toml | cut -d'"' -f2)
  deps=$(awk 'f && /^[[]/ {exit} /^[[]dependencies[]]/ {f=1; next} f && /^[a-zA-Z0-9_.-]+ *=/ {n++} END {print n+0}' Cargo.toml)
  cov=$(awk '/^lines /{print $2}' .coverage)
  inv=$(specs | xargs grep -ho '^V[0-9]*' 2>/dev/null | sort -u | wc -l | tr -d ' ')
  bug=$(specs | xargs grep -ho '^B[0-9]*' 2>/dev/null | sort -u | wc -l | tr -d ' ')
  nod=$(specs | wc -l | tr -d ' ')
  com=$(hk run pre-commit --plan --json -a < /dev/null 2>/dev/null | grep -c '"orderIndex"')
  pus=$(hk run pre-push --plan --json -a < /dev/null 2>/dev/null | grep -c '"orderIndex"')
  # The nixpkgs the whole fleet is pinned to, read from the LOCK rather than
  # from the branch name in flake.nix -- the branch says which series, the
  # lock says which commit, and only the second is what anybody builds.
  node=$(awk '/^    "nixpkgs": [{]/{f=1} f{print} f && /^    [}],?$/{exit}' flake.lock)
  nixref=$(printf '%s' "$node" | grep -m1 '"ref"' | cut -d'"' -f4 | sed 's/^nixos-//')
  nixrev=$(printf '%s' "$node" | grep -m1 '"rev"' | cut -d'"' -f4 | cut -c1-7)
  when=$(printf '%s' "$node" | grep -m1 '"lastModified"' | tr -dc '0-9')
  nixday=$(date -u -r "$when" +%Y-%m-%d 2>/dev/null || date -u -d "@$when" +%Y-%m-%d)
  # shields.io reads a single dash as a separator, so a date has to double
  # every one of its own to survive the trip.
  nixurl=$(printf %s "$nixday" | sed "s/-/--/g")
  # The CI badge points at the workflow in the repository Cargo.toml already
  # names, so the owner and repo are stated ONCE for the whole file.
  slug=$(grep -m1 '^repository = ' Cargo.toml | cut -d'"' -f2 | sed 's|https://github.com/||')

  for v in "$lic" "$ed" "$msrv" "$deps" "$cov" "$inv" "$bug" "$nod" "$com" "$pus" "$slug" "$nixref" "$nixrev" "$nixday"; do
    case "$v" in
      ''|0) echo 'hk: a badge source read EMPTY or ZERO, so nothing was rendered. One of Cargo.toml, .coverage, the SPEC.md set, or hk own plan did not answer. Fix the source -- a badge is not worth a guessed number.' >&2; exit 1 ;;
    esac
  done

  cat <<BADGES
<!-- BEGIN badges -->
[![CI](https://github.com/$slug/actions/workflows/ci.yml/badge.svg)](https://github.com/$slug/actions/workflows/ci.yml)
[![License: $lic](https://img.shields.io/badge/license-$lic-blue.svg)](LICENSE)
[![edition $ed](https://img.shields.io/badge/edition-$ed-000000?logo=rust&logoColor=white)](Cargo.toml)
[![MSRV $msrv](https://img.shields.io/badge/MSRV-$msrv-000000?logo=rust&logoColor=white)](Cargo.toml)
[![direct dependencies $deps](https://img.shields.io/badge/direct_dependencies-$deps-brightgreen)](docs/THIRD-PARTY-NOTICES.md)
[![unsafe forbidden](https://img.shields.io/badge/unsafe-forbidden-brightgreen)](Cargo.toml)
[![network none](https://img.shields.io/badge/network-none-brightgreen)](docs/SECURITY.md)

[![gate hk](https://img.shields.io/badge/gate-hk-6E4AFF)][hk]
[![gate steps $com commit / $pus push](https://img.shields.io/badge/gate_steps-${com}_commit_%2F_${pus}_push-6E4AFF)][hk]
[![coverage floor $cov%](https://img.shields.io/badge/coverage_floor-%E2%89%A5$cov%25-brightgreen)](.coverage)
[![invariants $inv](https://img.shields.io/badge/invariants-$inv-6E4AFF)](SPEC.md)
[![bugs logged $bug](https://img.shields.io/badge/bugs_logged-$bug-6E4AFF)](SPEC.md)
[![federated nodes $nod](https://img.shields.io/badge/federated_nodes-$nod-6E4AFF)](docs/FEDERATION.md)

[![nix flake](https://img.shields.io/badge/nix-flake-5277C3?logo=nixos&logoColor=white)][flake]
[![nixpkgs $nixref ($nixday - $nixrev)](https://img.shields.io/badge/nixpkgs-${nixref}_(${nixurl}_--_${nixrev})-5277C3?logo=nixos&logoColor=white)](https://github.com/${slug}/blob/main/flake.lock)
[![intel linux](https://img.shields.io/badge/linux-5277C3?logo=intel&logoColor=white)][flake]
[![amd linux](https://img.shields.io/badge/linux-5277C3?logo=amd&logoColor=white)][flake]
[![arm linux](https://img.shields.io/badge/linux-5277C3?logo=arm&logoColor=white)][flake]
[![arm macos](https://img.shields.io/badge/macos-5277C3?logo=arm&logoColor=white)][flake]

[![built with Claude Code](https://img.shields.io/badge/built_with-Claude_Code-D97757)](https://claude.com/claude-code)
[![built with Opus 5](https://img.shields.io/badge/built_with-Opus_5-D97757)](https://www.anthropic.com/claude)
[![built with SDD](https://img.shields.io/badge/built_with-spec--driven_development-D97757)](SPEC.md)
<!-- END badges -->
BADGES
}

"""

local fast = new Mapping<String, Step> {
  /// THE PRESENCE GATE (V26). A missing runner is NOT a pass.
  ///
  /// Every tool whose VERDICT this crate owns, checked in one place before
  /// anything else runs: `cargo` for the build and the tests, `mth` for
  /// SPEC.md's format, `itok` for the ceiling, `sherd` for the federation,
  /// and `rekall` for its own corpus. If one is absent the gate goes RED,
  /// because a step that silently did not happen reports the same green as
  /// a step that passed.
  ///
  /// ONE definition rather than a guard pasted into ten steps (V23). It
  /// carries no `glob`, so it always runs, and everything else chains from
  /// it -- a presence check that only fires when a Rust file changed would
  /// miss the case where nothing changed and nothing was checked.
  ///
  /// The optional third-party tools are deliberately NOT here. V26 draws
  /// the line at ownership: this crate answers for what `cargo test` says,
  /// and does not answer for whether `typos` is installed. Those skip and
  /// SAY SO, which is the other half of the same rule.
  ["runners"] {
    check = "sh .rekall/rules/a-gate-step-that-cannot-run.sh"
  }

  ["fmt"] {
    glob = List("**/*.rs")
    depends = List("runners")
    check = "cargo fmt --check"
    fix = "cargo fmt"
  }

  /// `-D warnings` is passed AFTER `--` rather than through RUSTFLAGS.
  /// RUSTFLAGS reaches PATH DEPENDENCIES, and V8 commits this crate to
  /// taking `itok` as one -- so the RUSTFLAGS form would let a sibling's
  /// stray warning redden this gate for code this crate does not own.
  ///
  /// No allow-list and no lint-debt file. This crate started at zero lines,
  /// so it can hold the full deny list from commit one; adopting it later
  /// would mean measuring a debt and ratcheting it down instead (V12, V27).
  ["clippy"] {
    glob = List("**/*.rs")
    depends = List("fmt")
    check = """
      cargo clippy --all-targets -- -D warnings || { echo 'hk: clippy is RED. Fix the code, not the threshold -- raising a number in clippy.toml to clear a limit is the exact reflex those limits exist to catch. An allow added instead must NAME what it exempts and why.' >&2; exit 1; }
      """
  }

  /// ASCII-only Rust source (SPEC.md §C): Trojan-Source resistance, and
  /// plain legibility for the models this tool exists to serve. SPEC.md is
  /// deliberately NOT in the glob -- its symbols are FORMAT, not source.
  ///
  /// The pattern is a POSIX RANGE under LC_ALL=C, not `grep -P` and not a
  /// `[:print:]` class. MEASURED on this box: `-P` does not exist in BSD
  /// grep, and `[^[:print:][:blank:]]` matched nothing against a UTF-8 byte
  /// pair there -- so both forms would have passed silently on half the
  /// supported platforms, which is a gate that reports green for a check it
  /// never performed (V26).
  ["ascii"] {
    glob = List("**/*.rs")
    check = "sh .rekall/rules/rust-source-is-ascii-only-specmd.sh"
  }

  /// EXTRACTED from CLAUDE.md by rekall (id b2c5684). The rule and its
  /// runner live in one file; this step decides only WHEN it runs (V24).
  ["allow-is-explained"] {
    glob = List("**/*.rs")
    check = "sh .rekall/rules/an-allow-must-name-what-it.sh"
  }

  /// EXTRACTED from CLAUDE.md by rekall (id 3edbbbe). It reads THIS file
  /// and every extracted runner beside it, so the gate is judged by the
  /// rule it carries rather than by anyone remembering it.
  /// SHIPPED docs must not link to UNSHIPPED files.
  ///
  /// `lychee` resolves every relative link in this repository and passes,
  /// because in a checkout they all exist. The `.crate` is a different file
  /// set: `hk.pkl`, `flake.nix` and `.github/` are excluded on purpose, and
  /// a link to one of them is a dead link for everyone reading on crates.io
  /// or docs.rs. MEASURED: 8 such links across 4 files, with the link
  /// checker green the whole time -- a check looking at the wrong file set.
  ///
  /// Links to an excluded file belong as ABSOLUTE urls to the repository,
  /// which is where that file actually lives.
  ["shipped-links"] {
    glob = List("README.md", "docs/**/*.md", ".crate-files", "Cargo.toml")
    check = """
      # NO BACKSLASHES IN THIS SCRIPT, deliberately. pkl does not collapse
      # `\\` in a triple-quoted string, so an escape written here reaches the
      # shell doubled and the pattern silently matches nothing -- which is
      # how the first draft of this step passed while a dead link was in the
      # README. Bracket classes do the same job and survive the trip.
      out=$(
        for f in README.md docs/*.md; do
          [ -f "$f" ] || continue
          grep -oE '][(][A-Za-z0-9_./-]+[)]' "$f" | sed 's/^..//; s/.$//' | while read -r t; do
            t="${t%%#*}"
            [ -z "$t" ] && continue
            case "$f" in
              docs/*) case "$t" in ../*) n="${t#../}" ;; *) n="docs/$t" ;; esac ;;
              *) n="$t" ;;
            esac
            grep -qxF "$n" .crate-files || echo "  $f -> $t"
          done
        done
      )
      [ -z "$out" ] && exit 0
      echo "hk: a SHIPPED doc links to a file the .crate EXCLUDES, so the link is dead for every reader on crates.io and docs.rs:" >&2
      echo "$out" >&2
      echo "Make it an absolute repository url, or stop excluding the file." >&2
      exit 1
      """
  }

  /// The README BADGE BLOCK, generated between the markers it already carried
  /// (T80). `check` renders and diffs; `fix` splices the render back in. hk
  /// runs a step's `fix` only when its `check` FAILS, so the README is
  /// rewritten on drift and never otherwise.
  ///
  /// WHY GENERATE rather than widen `readme-counts` to cover more numbers.
  /// The block holds eight declared figures and each was written three times
  /// -- alt text, shields.io URL, and the prose beside it. `readme-counts`
  /// read three of them, and only the URL copy of those three, so two numbers
  /// drifted green: `![invariants 59]` against a 63 URL, and `gate steps 21
  /// commit / 27 push` against a real 23 and 29, wrong in BOTH copies with
  /// nothing anywhere holding the right figure. That is V22's own defect
  /// living inside the runner written to prevent it, and gating a third copy
  /// would only have made the next one fail louder. Rendering removes the
  /// copies instead.
  ///
  /// The renderer is `renderBadges` above, shared with `fix` so there is one
  /// definition and two callers rather than two renderers (V23).
  ["badges"] {
    glob = List("README.md", "Cargo.toml", ".coverage", "hk.pkl", "SPEC.md", "src/**/SPEC.md", "flake.lock")
    check = renderBadges + """
      mkdir -p target
      render_badges > target/badges.rendered
      awk '/BEGIN badges/,/END badges/' README.md > target/badges.current
      diff -q target/badges.current target/badges.rendered >/dev/null || { echo 'hk: the README badge block DRIFTED from the sources it is rendered from. It is GENERATED -- run `hk fix -S badges` to re-render it, and do not hand-edit between the markers. The difference:' >&2; diff target/badges.current target/badges.rendered >&2; exit 1; }
      """
    /// Splices rather than rewrites the file: everything outside the markers
    /// is a human's prose and this step has no business touching it.
    fix = renderBadges + """
      mkdir -p target
      render_badges > target/badges.rendered
      awk -v f=target/badges.rendered '/<!-- BEGIN badges -->/ { while ((getline l < f) > 0) print l; s=1; next } /<!-- END badges -->/ { s=0; next } !s { print }' README.md > target/README.new || { echo 'hk: the badge block could not be spliced back into README.md. Check that both markers are still present and on their own lines.' >&2; exit 1; }
      mv target/README.new README.md
      """
  }

  /// The README's PROSE counts, against the specs they claim to count.
  ///
  /// Four numbers -- invariants, bug rows, and the landed/open task split --
  /// appear in SENTENCES in the README body, and every one of them drifted in
  /// a single session while the gate stayed green: 54 against 58, 10 against
  /// 18, 16 against 23. They are exactly V22's subject, a figure DECLARED
  /// with nothing reading it, and the fix is a runner rather than a habit.
  ///
  /// THE BADGE COPIES USED TO BE CHECKED HERE and no longer are. `badges`
  /// above GENERATES them (T80), which is strictly stronger than comparing
  /// them: a figure rendered from its source cannot disagree with it, so
  /// there is nothing left to compare. What stays is the prose, which is a
  /// human's sentences -- generating those would mean authoring them, and a
  /// generator that writes prose is a generator nobody trusts to run.
  ///
  /// INLINE, and not a script under `.rekall/rules/`. That directory belongs
  /// to EXTRACTED artifacts: every file in it is claimed by a ledger row that
  /// records which statement it came from and how to undo it, and `rekall
  /// check` calls anything else there an orphan. It did exactly that to the
  /// first draft of this step, which is the tool catching its own author.
  ["readme-counts"] {
    /// `hk.pkl` is in the glob because the STEP COUNTS below are read from
    /// hk's own plan: adding a step changes the true number, and the
    /// sentence that states it is in a file this step would otherwise never
    /// be woken for. That is exactly how it came to say 21 and 27 against a
    /// real 25 and 31 -- the badge was regenerated on every touch and the
    /// prose beside it was gated by nothing (V22).
    glob = List("README.md", "docs/*.md", "SPEC.md", "src/**/SPEC.md", "hk.pkl")
    check = """
      # The file list comes from `find` with `target/` excluded, and nothing
      # is summed. An earlier draft added per-file counts with
      # `grep -rhc | paste -sd+ | bc` and reported 232 landed tasks against a
      # real 23; the same pipeline by hand afterwards gave 23, so the cause
      # was never pinned down and is not guessed at here. This version sums
      # nothing.
      specs() { find . -name SPEC.md -not -path './target/*' -not -path './.git/*'; }
      rows() { specs | xargs grep -h "$1" 2>/dev/null | wc -l | tr -d ' '; }
      num() { grep -oE "$1" README.md | head -1 | grep -oE '[0-9]+' | head -1; }
      fail=0
      same() {
        [ "$2" = "$3" ] && return 0
        echo "hk: README says $1 is $2; the sources hold $3. Fix the SENTENCE in README.md. The badge carrying this number is GENERATED by the badges step; the prose is not, which is why it is still checked here (V22)." >&2
        fail=1
      }
      v=$(specs | xargs grep -ho '^V[0-9]*' 2>/dev/null | sort -u | wc -l | tr -d ' ')
      b=$(specs | xargs grep -ho '^B[0-9]*' 2>/dev/null | sort -u | wc -l | tr -d ' ')
      same 'tasks landed' "$(num 'at [0-9]+ landed')" "$(rows '^T[0-9]*|x|')"
      same 'tasks open' "$(num 'and [0-9]+ remaining')" "$(rows '^T[0-9]*|[.]|')"
      same 'invariants (prose)' "$(grep -oE 'truth . [0-9]+ invariants' README.md | grep -oE '[0-9]+')" "$v"
      same 'bug rows (prose)' "$(grep -oE '; [0-9]+ recorded' README.md | grep -oE '[0-9]+')" "$b"
      plan() { hk run "$1" --plan --json -a < /dev/null 2>/dev/null | grep -c '"orderIndex"'; }
      same 'gate steps on commit' "$(grep -oE '[0-9]+ steps on commit' README.md | grep -oE '[0-9]+')" "$(plan pre-commit)"
      same 'gate steps on push' "$(grep -oE 'commit, [0-9]+ on push' README.md | grep -oE '[0-9]+')" "$(plan pre-push)"
      # THE SAME NUMBERS, STATED ELSEWHERE. `docs/` repeats the step counts
      # and the invariant total, and until this ran only README.md was
      # checked -- so both files drifted to 21/27 and one advertised 51
      # invariants against a real 67, in the document the README tells a
      # reader to open FIRST. A number gated in one file and loose in the
      # next is not gated (V22).
      in_doc() { grep -oE "$2" "$1" | head -1 | grep -oE '[0-9]+' | head -1; }
      where() {
        [ "$3" = "$4" ] && return 0
        echo "hk: $1 says $2 is $3; the sources hold $4. Fix the SENTENCE there." >&2
        fail=1
      }
      for doc in docs/CONTRIBUTING.md docs/LLM-DISCLAIMER.md; do
        [ -f "$doc" ] || continue
        said=$(in_doc "$doc" '[0-9]+ steps on')
        [ -z "$said" ] || where "$doc" 'gate steps on commit' "$said" "$(plan pre-commit)"
        said=$(in_doc "$doc" 'on push')
        said=$(grep -oE '[0-9]+ on push' "$doc" | head -1 | grep -oE '[0-9]+' | head -1)
        [ -z "$said" ] || where "$doc" 'gate steps on push' "$said" "$(plan pre-push)"
        said=$(grep -oE '[0-9]+ .{0,4}V. invariants' "$doc" | head -1 | grep -oE '[0-9]+' | head -1)
        [ -z "$said" ] || where "$doc" 'invariants' "$said" "$v"
      done
      exit $fail
      """
  }

  ["failure-says-something"] {
    glob = List("hk.pkl", ".rekall/rules/**")
    check = "sh .rekall/rules/every-failing-step-names-the-fix.sh"
  }

  /// EXTRACTED from CLAUDE.md by rekall (id c75aeab). It carries no glob,
  /// so it runs every time: a hook that stopped being installed is a
  /// condition no file change announces.
  ["pre-push-installed"] {
    check = "sh .rekall/rules/run-hk-check-before-pushing.sh"
  }

  /// EXTRACTED from CLAUDE.md by rekall (id 551a009). No glob: the branch
  /// you are on is not something a file change announces.
  ["branch-not-main"] {
    check = "sh .rekall/rules/every-change-reaches-main-through-a.sh"
  }

  /// MODULE SIZE, the limit clippy does not have.
  ///
  /// It caps methods, parameters, nesting and complexity -- and nothing
  /// caps a FILE. `src/cli.rs` reached 1,878 lines of code with every
  /// function inside it passing, because the one dimension nobody
  /// measured is the one that drifted. V22, in the gate that was missing.
  ///
  /// CODE lines only: everything before `#[cfg(test)]`. A thorough test
  /// module is not the smell -- a file doing ten jobs is.
  ["module-size"] {
    glob = List("**/*.rs")
    check = """
      over=$(for f in $(find src -name '*.rs'); do
        n=$(awk '
          index($0, "#[cfg(test)]") == 1 { pending = NR; next }
          pending && index($0, "mod tests") == 1 { print pending - 1; found = 1; exit }
          { pending = 0 }
          END { if (!found) print NR }' "$f")
        t=$(wc -l < "$f" | tr -d ' ')
        if [ "$n" -gt 500 ]; then echo "  code $n  $f"; fi
        if [ "$t" -gt 1000 ]; then echo "  total $t  $f"; fi
      done)
      [ -z "$over" ] || { echo 'hk: module over a size cap -- 500 CODE lines (before `mod tests`), or 1000 TOTAL:' >&2; echo "$over" >&2; echo 'Split it by responsibility -- clippy caps functions but nothing caps a file, which is how cli.rs reached 1,878 code lines and later 3,001 total. Do NOT raise either number to make it pass.' >&2; exit 1; }
      """
  }

  ["test"] {
    /// A step's glob must name every INPUT its tests read, not just the
    /// language they are written in. Cargo.toml is here because the version
    /// and lint set live there; SPEC.md will join it the moment a test reads
    /// it, which T19 makes inevitable.
    glob = List("**/*.rs", "Cargo.toml")
    depends = List("clippy")
    check = """
      cargo test || { echo 'hk: a test failed. Decide WHICH kind before editing: a code bug, or a spec gap. A gap goes through SPEC.md first -- append the cause to section B so the invariant that would have caught it exists before the fix does.' >&2; exit 1; }
      """
  }

  /// THE FEDERATION'S RUNNER. `mth` is intra-file BY DESIGN and has no `§F`
  /// verb at all, so an edge table checked by nothing would be the
  /// declaration V22 forbids -- and this spec now carries twenty-two of
  /// them.
  ///
  /// `validate` is the whole verdict in one call: the DAG, the ids, every
  /// node's chain against its ceiling, and whether a `§N` drifted from the
  /// `§F` it is generated from. `sync --check` is separate because it
  /// answers a question `validate` cannot -- whether the nav WOULD be
  /// rewritten -- and a generated file nobody regenerates is stale by
  /// definition.
  ///
  /// SHERD IS OWNED, not optional (V26). It arrives as a pinned flake input
  /// -- `github:pr0d1r2/sherd`, the same class as `mth` and `itok` -- so this
  /// crate answers for whether it RAN, and its presence check belongs in
  /// `runners` with the other owned tools rather than in a guard here.
  ///
  /// It used to guard itself with `command -v sherd || exit 0`, describing
  /// itself in that message as an "optional third-party tool". THAT IS THE
  /// HALF OF B19 NOBODY FIXED. B19 records a stale dev shell holding an `mth`
  /// that joined the `§F` header onto its first row -- and, in the same
  /// breath, that `federation`, the ONE step which catches exactly that,
  /// SKIPPED for want of `sherd`. Corrupt and undetected in one run, three
  /// times over. The stale half was repaired and the skip that hid it was
  /// left standing, still exiting 0, still reading green.
  ["federation"] {
    glob = List("SPEC.md", "src/**/SPEC.md", ".context-limits")
    check = """
      sherd validate || { echo 'hk: the federation is not valid. A structural or edge failure is a node that cannot be read on its own; over a ceiling means a chain nobody can load in one window, and the fix is to move rows DOWN, not to raise the number.' >&2; exit 1; }
      sherd sync --check || { echo 'hk: a `§N` NAV drifted from the `§F` it is generated from. Run `sherd sync .` -- the nav is derived, so editing it by hand is the drift rather than the fix.' >&2; exit 1; }
      """
  }

  /// THE FORMAT OWNER. `mth` owns SPEC.md's format (§C) and arrives as a
  /// pinned flake input rather than off PATH, because the last time it was
  /// merely expected on PATH the check was silently deferred and nothing
  /// reported it (V26).
  ["spec-fmt"] {
    glob = List("SPEC.md")
    check = "mth fmt --check SPEC.md"
    fix = "mth fmt SPEC.md"
  }

  ["spec-check"] {
    glob = List("SPEC.md")
    depends = List("spec-fmt")
    check = """
      mth check SPEC.md || { echo 'hk: SPEC.md failed its own format check. Fix the spec, not the checker -- mth owns this format (section C) and this repo is its consumer.' >&2; exit 1; }
      """
  }

  /// THE CEILING'S RUNNER (V22). `itok check` reads `.context-limits` and
  /// exits nonzero on a breach, using its pinned tokenizer tier so the count
  /// is reproducible rather than a per-run estimate.
  ///
  /// Delegated, never reimplemented: itok owns token accounting (V8), and a
  /// second counter here would disagree with it eventually -- which is the
  /// same defect as two rule sets, and the one that argues loudest for
  /// itself because both numbers look plausible.
  ///
  /// On the COMMIT tier deliberately. The whole point of V12 is that the
  /// ceiling is felt while the file is being edited; a breach discovered on
  /// push is a breach discovered after the reasoning that caused it has been
  /// written and defended.
  ["context-limits"] {
    glob = List("SPEC.md", "README.md", ".context-limits")
    check = """
      itok check || { echo 'hk: a path is over its ceiling in .context-limits. Cut the file, or RAISE the number in a commit that says why -- a threshold raised reflexively trains the reflex instead of catching the problem (V12, V22).' >&2; exit 1; }
      """
  }

  /// CONSUMER #0 (T19). This crate checks its OWN corpus with its own
  /// binary -- a tool that gates other people's extractions and not its own
  /// is a tool nobody has run in anger.
  ///
  /// `rekall` reaches PATH through the dev shell's cargo-run shim, so this
  /// is the crate's own build and not a stale global install. It is an
  /// OWNED step: if the binary is missing the step FAILS rather than
  /// skipping, because a silent skip is a pass nobody earned (V26).
  ///
  /// On the COMMIT tier because it is cheap -- it reads a ledger and the
  /// handful of files that ledger names, with no network and no key (V6).
  ///
  /// The glob is the LEDGER and the places extraction touches. Today this
  /// repo has extracted nothing, so the step has nothing to say; it starts
  /// biting the moment the first statement moves, which is the commit where
  /// the obligation actually appears.
  ["rekall-check"] {
    glob = List(".rekall/**", "CLAUDE.md", "AGENTS.md", ".claude/skills/**")
    check = """
      rekall check || { echo 'hk: rekall found drift in its own corpus. Every line above already names its fix -- this note only says the failure is real and not a tooling error.' >&2; exit 1; }
      """
  }

  /// `nixfmt --check` gates the flake itself: that file decides what every
  /// other step runs with, so drift there is drift everywhere.
  /// The five steps below are OPTIONAL THIRD-PARTY tools, and V26 gives
  /// them the other treatment: absent means SKIP, and the skip is NAMED.
  ///
  /// The guard is a PRELUDE INSIDE the check, and it was hk's own
  /// `step_condition` first. MEASURED: with `display_skip_reasons`
  /// carrying "condition-false", a step whose condition evaluated false
  /// was reported at DEBUG level and NOWHERE ELSE --
  ///
  ///     DEBUG typos: condition: exec('command -v typos') = false
  ///
  /// -- so the run exited 0 having said nothing about a check it never
  /// performed. hk's native facility produces precisely the silent skip
  /// V26 forbids, which is the whole reason to prefer it and the reason
  /// it cannot be used.
  ///
  /// V24 still holds. Its rule is that hk decides WHEN and never what
  /// passing MEANS; the verdict here is still `typos`'s, the prelude only
  /// announces its absence, and the whole thing is still a plain command
  /// a human can paste.
  ["nixfmt"] {
    glob = List("**/*.nix")
    check = """
      command -v nixfmt >/dev/null 2>&1 || { echo "hk: SKIPPED nixfmt -- not on PATH. Optional third-party tool, so this is a skip, not a failure (V26). Enter the dev shell to run it." >&2; exit 0; }
      nixfmt --check flake.nix
      """
    fix = "nixfmt flake.nix"
  }

  ["taplo"] {
    glob = List("**/*.toml")
    check = """
      command -v taplo >/dev/null 2>&1 || { echo "hk: SKIPPED taplo -- not on PATH. Optional third-party tool, so this is a skip, not a failure (V26). Enter the dev shell to run it." >&2; exit 0; }
      taplo fmt --check
      """
    fix = "taplo fmt"
  }

  ["typos"] {
    glob = List("**/*")
    check = """
      command -v typos >/dev/null 2>&1 || { echo "hk: SKIPPED typos -- not on PATH. Optional third-party tool, so this is a skip, not a failure (V26). Enter the dev shell to run it." >&2; exit 0; }
      typos
      """
    fix = "typos --write-changes"
  }

  /// Secrets. hk's `detect-private-key` builtin does exactly what its name
  /// says and nothing else, so a token-shaped secret walks straight past it.

  /// The four formatting rules NOTHING ELSE OWNS.
  ///
  /// `.editorconfig` is a declaration, and a declaration no runner reads is
  /// a wish (V22) -- editors honour it only if the person editing has the
  /// plugin, which is exactly the enforcement-by-hope this repo refuses. So
  /// the file lands with this step, in the same commit, and the step checks
  /// the four rules that are genuinely unclaimed: line endings, tabs,
  /// trailing whitespace, and the final newline.
  ///
  /// It does NOT check indentation width. rustfmt, taplo and nixfmt each own
  /// that for their own files and are already in this gate; a second opinion
  /// here would be a rule that can disagree with the formatter that runs
  /// after it.
  ///
  /// No `editorconfig-checker` dependency: the whole check is four lines of
  /// git and grep, and this repo does not add a dependency for what the
  /// tools already present can do.
  ///
  /// EVERY LINE HERE MUST SUCCEED. hk runs a check under errexit, so a
  /// bare failing test anywhere -- including inside a loop body, where it
  /// reads as a condition and is not one -- kills the step with no message
  /// at all. MEASURED: the first draft died on the first file that ended
  /// correctly, reporting nothing, which is the silent failure the
  /// `failure-says-something` runner exists to forbid and cannot see,
  /// because it greps for a literal `exit 1`.
  ["editorconfig"] {
    glob = List("**/*")
    check = """
      fail=0
      say() { echo "hk: $1" >&2; echo "$2" >&2; fail=1; }
      eol=$(git ls-files --eol | grep -E '^i/(crlf|mixed)' || true)
      [ -z "$eol" ] || say '.editorconfig says every file is LF, and these are not:' "$eol"
      tabs=$(git ls-files -z | xargs -0 awk 'index($0, sprintf("%c", 9)) > 0 { print FILENAME }' 2>/dev/null | sort -u || true)
      [ -z "$tabs" ] || say '.editorconfig says spaces, and these hold a tab:' "$tabs"
      trail=$(git ls-files -z | xargs -0 grep -lIE '[[:blank:]]+$' 2>/dev/null || true)
      [ -z "$trail" ] || say '.editorconfig trims trailing whitespace, and these keep some:' "$trail"
      last=$(git ls-files | while read -r f; do [ -f "$f" ] && [ -s "$f" ] && [ -n "$(tail -c1 "$f")" ] && echo "$f" || true; done)
      [ -z "$last" ] || say '.editorconfig ends every file with a newline, and these do not:' "$last"
      exit $fail
      """
  }

  ["ripsecrets"] {
    glob = List("**/*")
    check = """
      command -v ripsecrets >/dev/null 2>&1 || { echo "hk: SKIPPED ripsecrets -- not on PATH. Optional third-party tool, so this is a skip, not a failure (V26). Enter the dev shell to run it." >&2; exit 0; }
      ripsecrets || { echo 'hk: a secret is in a tracked file. ROTATE it -- deleting the line does not help, because git history keeps every version of it.' >&2; exit 1; }
      """
  }


  /// `actionlint` on the workflow, the ONE tracked file no other step reads
  /// and the only one that runs on a machine nobody can attach to.
  ///
  /// THE TOOL WAS ALREADY PROVISIONED AND CALLED BY NOTHING. flake.nix put
  /// actionlint in the dev shell and no step invoked it, which is V22's
  /// defect wearing a tool's clothes rather than a number's: something
  /// DECLARED, costing setup, exiting nonzero on nothing. Shipping a linter
  /// nobody runs is the same green-for-nothing the rest of this file refuses.
  ///
  /// The failure it guards is specific and dated. ci.yml has NEVER EXECUTED
  /// -- its own header says so, and `.:B17` records that the repository it
  /// would run on does not exist yet -- so the first time this workflow is
  /// read by GitHub is the first push of a repository that has just gone
  /// public. A syntax error there is discovered by strangers.
  ///
  /// Bare `actionlint` rather than a path list: it discovers
  /// `.github/workflows` itself, so a second workflow added later is linted
  /// without anyone remembering to extend an argument here.
  ///
  /// NO `fix`. actionlint reports and does not rewrite, and a step claiming
  /// a fix it cannot perform is worse than one that admits it has none.
  ["actionlint"] {
    glob = List(".github/workflows/**")
    check = """
      command -v actionlint >/dev/null 2>&1 || { echo "hk: SKIPPED actionlint -- not on PATH. Optional third-party tool, so this is a skip, not a failure (V26). Enter the dev shell to run it." >&2; exit 0; }
      actionlint
      """
  }


  /// Whether the workflow is SAFE, next to `actionlint`'s whether it is
  /// CORRECT. Rust, and the only tool in this gate that reads a workflow as
  /// an attack surface rather than as a schema.
  ///
  /// IT FOUND FIVE THINGS ON ITS FIRST RUN, all medium and all real: two
  /// checkouts leaving the job's token in `.git/config` where a later step
  /// or a cached `target/` could carry it off, and three jobs holding the
  /// default `GITHUB_TOKEN` scope when none of them writes anything. Both
  /// are one line to fix and neither would have been noticed by reading.
  ///
  /// The alternative considered and REJECTED was `yamllint`: it is Python,
  /// and the fleet's own config for it disables the two rules that would
  /// fire on a workflow file, so it would have added a dependency to check
  /// indentation on the one YAML file `actionlint` already reads.
  ["zizmor"] {
    glob = List(".github/workflows/*.yml")
    check = """
      command -v zizmor >/dev/null 2>&1 || { echo "hk: SKIPPED zizmor -- not on PATH. Optional third-party tool, so this is a skip, not a failure (V26). Enter the dev shell to run it." >&2; exit 0; }
      zizmor --offline --quiet .github/workflows/ || { echo 'hk: the workflow has a security finding. Each one names its audit and links the rule; fix it, or suppress it in the workflow with a comment that says why.' >&2; exit 1; }
      """
  }


  /// RELATIVE LINKS, across every tracked file rather than only markdown.
  /// README.md and the docs/ tree point at LICENSE, hk.pkl, flake.nix and
  /// each other, so a link can break with no markdown touched at all --
  /// renaming a config file is enough.
  ///
  /// `--offline` is not a speed choice. This crate reaches the network
  /// nowhere, and a gate step that fetches every external URL on every
  /// commit would make that false in the one place a developer meets most
  /// often. A dead external link is a documentation problem; a gate that
  /// needs a network is a gate that goes soft on a plane.
  ["links"] {
    glob = List("**/*")
    /// Absence before findings: `lychee: command not found` is also a
    /// non-zero exit, and reporting it as a broken link sends the reader
    /// hunting for a bad path that does not exist. MEASURED in a sibling,
    /// where exactly that message cost a push.
    check = """
      command -v lychee >/dev/null 2>&1 || { echo "hk: SKIPPED links -- lychee is not on PATH. Optional third-party tool, so this is a skip and not a failure (V26) -- and NOT a broken link. Enter the dev shell to run it." >&2; exit 0; }
      lychee --offline --no-progress . || { echo 'hk: a relative link does not resolve. Fix the path, or the file it points at.' >&2; exit 1; }
      """
  }

  /// THE SUPPLY CHAIN. Five direct dependencies and 26 in the tree, so
  /// "there is nothing to scan" -- the honest answer in a zero-dependency
  /// sibling -- is not available here.
  ///
  /// `advisories` is NOT in this step: it fetches the RustSec database, and
  /// this set runs on every commit. This crate's whole claim is that it
  /// never reaches the network, so the one check that does lives in the
  /// push set, in `deny-advisories` below.
  ["deny"] {
    glob = List("Cargo.toml", "Cargo.lock", "deny.toml")
    /// Absence before findings: `no such command: deny` is also a non-zero
    /// exit, and reporting it as a rejected dependency tree names the wrong
    /// cause entirely.
    check = """
      cargo deny --version >/dev/null 2>&1 || { echo "hk: SKIPPED cargo-deny -- not on PATH. Optional third-party tool, so this is a skip and not a failure (V26) -- and NOT a clean dependency tree. Enter the dev shell to run it." >&2; exit 0; }
      cargo deny check bans licenses sources || { echo 'hk: cargo-deny rejected the dependency tree. A NEW DEPENDENCY is a decision, not a detail, and a new LICENCE is permission granted to everything downstream forever. Both belong in deny.toml as a deliberate edit, with the argument beside them.' >&2; exit 1; }
      """
  }


}

/// The PUSH tier: everything too slow for a commit hook. A ~60s step on
/// commit is a step someone learns to bypass, and a bypassed hook is worse
/// than no hook.
local all = (fast) {
  /// Doc examples are TESTS. The one on `config::merge` pins the union
  /// rule -- the single asymmetry in the merge -- so the behaviour that is
  /// easiest to "simplify" away is asserted by the documentation that
  /// explains it.
  ///
  /// Absent from commit one because the crate was bin-only and `cargo test
  /// --doc` errors with "no library targets found". A step that cannot pass
  /// is not a gate, it is a red nobody can clear (T32).
  ["doctest"] {
    glob = List("**/*.rs")
    depends = List("test")
    check = """
      cargo test --doc || { echo 'hk: a doc example failed. Doc examples are TESTS: fix the example or the code, and do not reach for no_run to quiet it.' >&2; exit 1; }
      """
  }

  ["rustdoc"] {
    glob = List("**/*.rs")
    depends = List("doctest")
    check = """
      cargo doc --no-deps --quiet || { echo 'hk: rustdoc failed, usually a broken intra-doc link. Fix the link target or spell it out in backticks.' >&2; exit 1; }
      """
  }

  /// The crate must build with no default features, because a consumer may
  /// take it that way and nothing else here would notice.
  ["no-default-features"] {
    glob = List("**/*.rs", "Cargo.toml")
    depends = List("rustdoc")
    check = """
      cargo build --no-default-features --quiet || { echo 'hk: the crate does not build without default features, and a consumer may take it that way. Gate the feature-dependent code with cfg, or make the dependency non-optional and say why.' >&2; exit 1; }
      """
  }

  /// Publishing does not ship the REPO, it ships a tarball whose file set is
  /// DERIVED -- git-tracked, minus `exclude`. That is a second file set
  /// nothing else in this repo examines.
  /// the right files, and only the first was ever asked here. `.crate-files`
  /// records the second answer so a change to it lands in a DIFF a reviewer
  /// reads, rather than being discovered by a consumer at publish time.
  ///
  /// MEASURED, which is why this step exists: the crate shipped a generated
  /// skill from `.claude/skills/` while excluding the `.rekall/` ledger that
  /// records it -- an orphan artifact, the state `check` exits 1 on, inside
  /// the tarball of the tool that refuses it. `cargo package` was green
  /// throughout, because a tarball with a wrong file set still builds.
  ["package"] {
    glob = List("**/*.rs", "Cargo.toml", ".crate-files")
    depends = List("no-default-features")
    check = """
      cargo package --quiet --allow-dirty --target-dir target/package-verify || { echo 'hk: cargo package failed. It ships a DERIVED file set -- git-tracked minus exclude -- so this is usually a path the tarball needs and does not have, or an exclude in Cargo.toml that took too much.' >&2; exit 1; }
      mkdir -p target
      cargo package --list --allow-dirty 2>/dev/null | sort > target/crate-files.txt || { echo 'hk: `cargo package --list` failed, so what the tarball would ship could not be read at all.' >&2; exit 1; }
      diff -q .crate-files target/crate-files.txt >/dev/null || { echo 'hk: what the .crate SHIPS changed. The lines below are the difference between the recorded file set and the one this tree would publish. If it is intended, run `hk fix -S package` to record it. If it is not, something was added, deleted or excluded by accident.' >&2; diff .crate-files target/crate-files.txt >&2; exit 1; }
      """
    /// Records rather than judges. The point is never that a change is
    /// wrong -- it is that a change is SEEN, in a diff, by whoever is about
    /// to publish.
    fix = """
      mkdir -p target
      cargo package --list --allow-dirty 2>/dev/null | sort > .crate-files || { echo 'hk: `cargo package --list` failed, so there is nothing to record.' >&2; exit 1; }
      """
  }

  /// THE RATCHET (V27). The floor may RISE, never fall, and it MUST rise
  /// when coverage does. `.coverage` carries the number.
  ///
  /// Two margins, and they are not symmetric on purpose. A fall of up to
  /// 0.3 is tolerated as measurement jitter. A rise of more than 0.5 is a
  /// FAILURE, cleared by `hk fix --all`, which records it.
  ///
  /// That second half was missing and the gate was quietly broken by it.
  /// hk runs a step's `fix` only when its `check` FAILS, so a rise -- which
  /// passed -- never reached the code that records it, and the printed
  /// advice named a command (`hk run fix`) that does not exist. The floor
  /// would have drifted further below reality with every well-tested
  /// commit, protecting less and less while reporting green.
  ///
  /// Failing on a stale floor is the same shape as `cargo fmt --check`
  /// failing on an unformatted file: not a complaint about the work, just
  /// a record that has not caught up. One command fixes it.
  ///
  /// It starts at the scaffold's own figure rather than at an aspirational
  /// one: a floor nobody can pay gates every commit red for weeks, and the
  /// first thing anyone does with a gate they cannot pay is bypass it.
  ["coverage"] {
    glob = List("**/*.rs", ".coverage")
    depends = List("package")
    check = "sh .rekall/rules/the-coverage-floor-only-ever-rises.sh"
    /// `fix` may only RAISE. A ratchet that writes down whatever it measures
    /// is not a ratchet -- it files down its own teeth on exactly the commit
    /// it existed to refuse (V27).
    fix = """
      out=$(cargo llvm-cov --summary-only 2>&1) || { echo "$out" >&2; exit 1; }
      now=$(printf '%s' "$out" | awk '/^TOTAL/{gsub("%","",$10); print $10}')
      was=$(awk '/^lines /{print $2}' .coverage)
      [ -n "$now" ] || { echo 'hk: could not read a coverage total, so there is nothing to record. Run `cargo llvm-cov --summary-only` and see what it says before retrying.' >&2; exit 1; }
      awk -v n="$now" -v w="$was" 'BEGIN{exit !(n+0 < w+0)}' && { echo "hk: refusing to RECORD a drop, $was% -> $now%. Cover the gap, or edit .coverage by hand with the reason." >&2; exit 1; }
      awk -v n="$now" '/^lines /{print "lines " n; next} {print}' .coverage > .coverage.new
      mv .coverage.new .coverage
      """
  }

  /// THE ONE NETWORK STEP IN THE WHOLE GATE. It fetches the RustSec
  /// advisory database, so it sits with the expensive axes rather than on
  /// every commit -- this crate reaches the network nowhere, and the gate
  /// should not quietly make a developer do so on every `git commit`.
  ///
  /// Paired with `deny` in the fast set, which is what keeps the tree small
  /// enough for this to mean something.
  ["deny-advisories"] {
    glob = List("Cargo.toml", "Cargo.lock", "deny.toml")
    depends = List("coverage")
    /// Absence before findings, as in `deny`: a missing tool is not a clean
    /// bill of health.
    check = """
      cargo deny --version >/dev/null 2>&1 || { echo "hk: SKIPPED cargo-deny -- not on PATH. Optional third-party tool, so this is a skip and not a failure (V26) -- and NOT a clean dependency tree. Enter the dev shell to run it." >&2; exit 0; }
      cargo deny check advisories || { echo 'hk: a dependency carries a security advisory or has been yanked. Bump it, or record why it is not reachable from this crate in deny.toml.' >&2; exit 1; }
      """
  }
}

hooks {
  /// `stash = "git"` is correctness, not speed -- without it a partially
  /// staged file (`git add -p`) is checked as it looks in the WORKTREE,
  /// giving a verdict about code you are not committing.
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = fast
  }

  ["pre-push"] {
    steps = all
  }

  /// What `hk check` runs -- the entry point for CI and for a by-hand full
  /// run. ONE definition, many callers (V23): CI calls this, it does not
  /// copy the step list into a workflow file.
  ["check"] {
    steps = all
  }

  ["fix"] {
    fix = true
    steps = all
  }
}
